{
  "_base_": [
    "./dota_le90_1x_s.json"
  ],
  "training": {
    "use_amp": true,
    "num_epochs": 72,
    "lr_warmup_steps": 10000
  },
  "preprocessing": {
    "enable_mosaic": true,
    "target_size": [1024, 1024],
    "mosaic_img_scale": [1024, 1024],
    "mosaic_ratio_range": [0.5, 1.5],
    "mosaic_disable_last_n_epochs": 10,
    "enable_random_rotate": true,
    "random_rotate_prob": 0.5,
    "random_rotate_angle_range": 180
  },
  "evaluation": {
    "val_map_every_n_epochs": 6
  }
}
